---
interface Props {
  name: "phone" | "whatsapp" | "pin" | "clock" | "arrow" | "close" | "menu" | "plus";
  class?: string;
}
const { name, class: cls = "" } = Astro.props;
---

{name === "phone" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5L16 13l4 1.5v3a2 2 0 0 1-2.2 2C10.5 19 5 13.5 4.5 6.2A2 2 0 0 1 6.5 4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
  </svg>
)}

{name === "whatsapp" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 4a8 8 0 0 0-6.9 12l-1 3.6 3.7-1A8 8 0 1 0 12 4Z" stroke="currentColor" stroke-width="1.3"/>
    <path d="M9 9.6c0 3 2.4 5.4 5.4 5.4.6 0 1-.5.9-1l-.2-1-1.7-.4-.8.8a4.6 4.6 0 0 1-2.6-2.6l.8-.8-.4-1.7-1-.2c-.5 0-1 .4-1 .9Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
  </svg>
)}

{name === "pin" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
    <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.3"/>
  </svg>
)}

{name === "clock" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.3"/>
    <path d="M12 8v4.3l3 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>
)}

{name === "arrow" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "close" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>
)}

{name === "menu" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>
)}

{name === "plus" && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>
)}
