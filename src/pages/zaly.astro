---
import Layout from "@/layouts/Layout.astro";
import ReserveForm from "@/components/ReserveForm";
import { HALLS, EVENT_FORMATS } from "@/data/halls";
import { CONTACTS } from "@/data/contacts";
import { withBase } from "@/lib/url";
---

<Layout
  title="Залы и мероприятия — Лесная Заимка"
  description="Шесть залов «Лесной Заимки» во Владивостоке — от камерных банкетов на 30 человек до торжеств на 500 гостей. Свадьбы, корпоративы, банкеты, кейтеринг."
>
  <section class="relative flex h-[56vh] min-h-[420px] items-end overflow-hidden bg-obsidian">
    <img src={withBase("/img/gallery/corporate/full/9.webp")} alt="Большой зал «Лесной Заимки»" class="ken-burns absolute inset-0 h-full w-full object-cover opacity-60" />
    <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(to top, rgba(10,9,8,1) 0%, rgba(10,9,8,0.5) 60%, rgba(10,9,8,0.55) 100%);"></div>
    <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6 pb-16 md:px-10">
      <p class="eyebrow mb-5" data-reveal>Круг шире</p>
      <h1 class="font-display text-5xl font-light text-ivory md:text-7xl" data-reveal>Залы и мероприятия</h1>
      <p class="mt-5 max-w-md text-sm text-ivory-dim" data-reveal data-reveal-delay="1">
        Шесть залов — от камерного вечера на тридцать человек до торжества на пятьсот гостей.
      </p>
    </div>
  </section>

  <!-- FORMATS -->
  <section class="border-b border-obsidian-line bg-obsidian px-6 py-16 md:px-10">
    <div class="mx-auto flex max-w-[1400px] flex-wrap gap-x-10 gap-y-4">
      {EVENT_FORMATS.map((f, i) => (
        <p class="eyebrow flex items-center gap-3 text-ivory-dim" data-reveal data-reveal-delay={String(i % 4)}>
          <span class="h-1 w-1 rounded-full bg-brass"></span>
          {f}
        </p>
      ))}
    </div>
  </section>

  <!-- HALLS GRID -->
  <section class="bg-obsidian px-6 py-24 md:px-10">
    <div class="mx-auto max-w-[1400px]">
      <div class="grid gap-px overflow-hidden bg-obsidian-line md:grid-cols-2">
        {HALLS.map((hall, i) => (
          <div class="group bg-obsidian" data-reveal data-reveal-delay={String(i % 2)}>
            <div class="img-zoom relative aspect-[16/10]">
              <img src={withBase(hall.image)} alt={hall.name} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="p-8">
              <h2 class="font-display text-2xl font-light text-ivory">{hall.name}</h2>
              <p class="mt-3 text-sm text-ivory-dim">{hall.description}</p>
              <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs text-brass">
                <span>{hall.capacity}</span>
                {hall.area && <span>{hall.area}</span>}
                <span class="text-ivory-dim">аренда по запросу</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BOOKING FORM -->
  <section id="booking" class="border-t border-obsidian-line bg-obsidian-soft px-6 py-24 md:px-10">
    <div class="mx-auto grid max-w-[1400px] gap-16 md:grid-cols-[1fr_1.2fr]">
      <div data-reveal>
        <p class="eyebrow mb-6">Ваше торжество</p>
        <h2 class="font-display mb-8 text-4xl font-light text-ivory md:text-5xl">Оставьте заявку на зал</h2>
        <p class="max-w-sm text-sm leading-relaxed text-ivory-dim">
          Расскажите о формате мероприятия — подберём зал, меню и дату. Для срочных вопросов звоните напрямую.
        </p>
        <a href={CONTACTS.phoneEventsHref} class="btn-outline mt-8 inline-flex">
          <span>{CONTACTS.phoneEvents}</span>
        </a>
      </div>
      <div data-reveal data-reveal-delay="1">
        <ReserveForm context="event" client:load />
      </div>
    </div>
  </section>
</Layout>
